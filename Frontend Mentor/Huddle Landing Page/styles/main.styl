purple = #674baf;
magenta = #e882e8;
mainFont = 'Poppins', sans-serif;

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 10px;
}

img {
  max-width: 100%;
  display: block;
}

body {
  font-family: mainFont;
}

.container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.card {
  padding: 2rem;
  min-height: 69rem;
  max-width: 144rem;
  background-color: purple;
  background-image: url('../images/bg-desktop.svg');
  background-repeat: no-repeat;
  background-position: center;
  background-size: cover;
}

.card-top {
  padding: 3rem;
}

.card-middle {
  padding: 3rem;
  display: flex;
  gap: 4rem;
  align-items: center;

  .left {
    flex: 0 1 60%;
  }

  .right {
    flex: 0 1 40%;

    h2 {
      font-size: 4rem;
      color: #fff;
      margin-bottom: 2rem;
    }

    p {
      font-size: 1.4rem;
      color: #fff;
      margin-bottom: 2rem;
    }

    button {
      border: none;
      padding: 2rem 6rem;
      border-radius: 30px;
      font-size: 2rem;
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.5);
    }
  }
}

.card-bottom {
  padding: 3rem;
  display: flex;
  justify-content: flex-end;

  footer {
    display: flex;
    gap: 1.2rem;
  }

  i {
    color: #fff;
    font-size: 1.6rem;
    width: 3.2rem;
    height: 3.2rem;
    display: grid;
    place-items: center;
    border: 1px solid #fff;
    border-radius: 50%;
    line-height: 1;

    &:hover {
      border-color: magenta;
    }
  }
}

@media (max-width: 900px) {
  .container {
    height: auto;
    align-items: stretch;
    padding: 3rem 0;
  }

  .card {
    min-height: auto;
    width: 100%;
    max-width: 37.5rem;
    background-image: url('../images/bg-mobile.svg');
  }

  .card-middle {
    flex-direction: column;

    .left, .right {
      flex-basis: auto;
      width: 100%;
    }

    .right {
      h2 {
        font-size: 3.4rem;
      }

      p {
        font-size: 1.6rem;
        line-height: 1.7;
      }

      button {
        padding: 1.5rem;
      }
    }
  }

  .card-bottom {
    padding-top: 1rem;
    justify-content: center;
  }
}
